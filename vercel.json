{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/pages/legal/:name/page", "destination": "/:name/", "permanent": true },
    { "source": "/pages/legal/:name/page.html", "destination": "/:name/", "permanent": true },
    { "source": "/pages/legal/:name/", "destination": "/:name/", "permanent": true },
    { "source": "/pages/legal/:name", "destination": "/:name/", "permanent": true },
    { "source": "/pages/:path*/page", "destination": "/:path*/", "permanent": true },
    { "source": "/pages/:path*/page.html", "destination": "/:path*/", "permanent": true },
    { "source": "/pages/:path*/", "destination": "/:path*/", "permanent": true },
    { "source": "/pages/:path*", "destination": "/:path*/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(public|assets)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
